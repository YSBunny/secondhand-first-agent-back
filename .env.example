DB_URL=jdbc:mysql://127.0.0.1:3306/second-hand-first-local?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

SPRING_PROFILES_ACTIVE=local

# 카카오 REST API 키. 위치 검색과 거리 계산에 쓴다.
# .example 은 자리표시자만 둔다 — 실제 값은 각자 .env 에 넣는다.
KAKAO_REST_API_KEY=

# AI 서버 주소. 비워 두면 검색이 502로 끝난다.
# 로컬에서 AI를 함께 띄웠다면 http://localhost:8000
AI_BASE_URL=

# AI 서버와 공유하는 내부 API 키. 양쪽이 같은 값이어야 한다.
# AI 쪽이 비어 있으면 여기도 비워 둔다.
AI_API_KEY=
